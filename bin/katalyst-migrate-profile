#!/usr/bin/env python3
"""Import a user's Cursor/Codex setup into local Katalyst state only."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import sys
import tomllib
from typing import Any


def load_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def copy_file(source: Path, destination: Path) -> bool:
    if not source.is_file():
        return False
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)
    return True


def import_skills(home: Path, state_home: Path) -> int:
    destinations = state_home / "skills"
    sources = {
        "cursor": [home / ".agents" / "skills", home / ".cursor" / "skills"],
        "codex": [home / ".codex" / "skills"],
    }
    copied = 0
    for source_name, roots in sources.items():
        for root in roots:
            if not root.is_dir():
                continue
            for skill in sorted(root.iterdir()):
                if not skill.is_dir() or not (skill / "SKILL.md").is_file():
                    continue
                target = destinations / f"{source_name}-{skill.name}"
                if target.exists():
                    shutil.rmtree(target)
                shutil.copytree(skill, target)
                copied += 1
    return copied


def compatible_server(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    server = {key: value[key] for key in ("command", "args", "env", "url", "headers") if key in value}
    return server if "command" in server or "url" in server else None


def cursor_servers(home: Path) -> dict[str, dict[str, Any]]:
    raw = load_json(home / ".cursor" / "mcp.json").get("mcpServers", {})
    return {name: parsed for name, value in raw.items() if isinstance(name, str) and (parsed := compatible_server(value))}


def codex_servers(home: Path) -> dict[str, dict[str, Any]]:
    path = home / ".codex" / "config.toml"
    if not path.is_file():
        return {}
    try:
        raw = tomllib.loads(path.read_text(encoding="utf-8")).get("mcp_servers", {})
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    servers: dict[str, dict[str, Any]] = {}
    for name, value in raw.items():
        if not isinstance(name, str) or not (parsed := compatible_server(value)):
            continue
        command = parsed.get("command")
        if isinstance(command, str) and command.startswith("./Codex Computer Use.app/"):
            local_client = home / ".codex" / "computer-use" / command.removeprefix("./")
            if local_client.is_file():
                parsed["command"] = str(local_client)
        servers[name] = parsed
    return servers


def run(home: Path, state_home: Path) -> dict[str, Any]:
    private = state_home / "private-profile"
    config_sources = {
        private / "cursor" / "mcp.json": home / ".cursor" / "mcp.json",
        private / "cursor" / "settings.json": home / ".cursor" / "settings.json",
        private / "cursor" / "hooks.json": home / ".cursor" / "hooks.json",
        private / "codex" / "config.toml": home / ".codex" / "config.toml",
        private / "codex" / "hooks.json": home / ".codex" / "hooks.json",
    }
    copied_configs = [str(target.relative_to(state_home)) for target, source in config_sources.items() if copy_file(source, target)]
    copied_workflows: list[str] = []
    for target, source in {
        private / "cursor" / "rules": home / ".cursor" / "rules",
        private / "cursor" / "commands": home / ".cursor" / "commands",
        private / "cursor" / "hooks": home / ".cursor" / "hooks",
    }.items():
        if source.is_dir():
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(source, target)
            copied_workflows.append(str(target.relative_to(state_home)))
    skills_imported = import_skills(home, state_home)

    destination = home / ".omp" / "agent" / "mcp.json"
    merged = load_json(destination)
    servers = merged.setdefault("mcpServers", {})
    if not isinstance(servers, dict):
        servers = {}
        merged["mcpServers"] = servers
    imported: list[str] = []
    skipped: list[str] = []
    for name, server in {**cursor_servers(home), **codex_servers(home)}.items():
        if name in servers:
            skipped.append(name)
        else:
            servers[name] = server
            imported.append(name)
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(json.dumps(merged, indent=2) + "\n", encoding="utf-8")
    return {
        "skillsImported": skills_imported,
        "privateConfigCopied": copied_configs,
        "mcpImported": sorted(imported),
        "mcpSkipped": sorted(skipped),
        "privateWorkflowCopied": copied_workflows,
        "stateHome": str(state_home),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument("--state-home", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    result = run(args.home, args.state_home or args.home / ".katalyst")
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print(f"Imported {result['skillsImported']} local skills and {len(result['mcpImported'])} MCP servers.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
