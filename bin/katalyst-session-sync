#!/usr/bin/env python3
from pathlib import Path
import sys

script = Path(__file__).resolve()
repository_lib = script.parents[1] / "lib"
installed_lib = script.parent
module_dir = installed_lib if (installed_lib / "katalyst_session_sync.py").is_file() else repository_lib
sys.path.insert(0, str(module_dir))
from katalyst_session_sync import main

raise SystemExit(main())
