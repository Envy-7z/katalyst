#!/usr/bin/env bash
# Katalyst 1-command updater: OMP + Zed rebase.
set -euo pipefail

export PATH="/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"

echo "=== Updating OMP ==="
if command -v omp >/dev/null 2>&1; then
  omp update
else
  echo "OMP not installed. Run: brew install can1357/tap/omp"
fi

if [[ -d "$HOME/zed-custom" ]]; then
  echo ""
  echo "=== Checking Zed upstream updates ==="
  cd "$HOME/zed-custom"
  git fetch upstream main >/dev/null 2>&1 || true
  BEHIND="$(git rev-list --count HEAD..upstream/main 2>/dev/null || echo 0)"
  if [[ "$BEHIND" -gt 0 ]]; then
    echo "Katalyst is behind upstream by $BEHIND commit(s)."
    if [[ -t 0 ]]; then
      read -r -p "Rebuild Katalyst now? [y/N] " ans
      if [[ "$ans" =~ ^[yY]$ ]]; then
        bash "$HOME/zed-custom/scripts/sync-and-rebuild.sh"
      fi
    fi
  else
    echo "Katalyst is up to date with upstream/main."
  fi
fi
