{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high"
    }
  },
  "minimap": {
    "show": "always"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "omp": {
      "type": "custom",
      "command": "omp",
      "args": [
        "acp",
        "--yolo"
      ],
      "env": {}
    }
  },
  "context_servers": {
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp"
    }
  }
}
