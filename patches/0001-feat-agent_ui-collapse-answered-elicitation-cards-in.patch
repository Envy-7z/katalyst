From 51d2c1b4f31c46ddd2e0caaa0ba47927400e5627 Mon Sep 17 00:00:00 2001
From: Wisnuu <wisnuandrian325@gmail.com>
Date: Sun, 6 Sep 2026 15:48:48 +0700
Subject: [PATCH 01/19] feat(agent_ui): collapse answered elicitation cards
 into compact badges

Collapse completed, declined, and canceled elicitation cards into a
compact single-line badge to prevent cluttering conversation history.
---
 .../src/conversation_view/elicitation.rs      | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/crates/agent_ui/src/conversation_view/elicitation.rs b/crates/agent_ui/src/conversation_view/elicitation.rs
index 4efb8f8..2da7b4c 100644
--- a/crates/agent_ui/src/conversation_view/elicitation.rs
+++ b/crates/agent_ui/src/conversation_view/elicitation.rs
@@ -1473,6 +1473,16 @@ impl<'a> ElicitationCard<'a> {
             ElicitationStatus::Canceled => ("Canceled", IconName::Circle, Color::Muted),
             ElicitationStatus::Completed => ("Completed", IconName::Check, Color::Success),
         };
+        if !is_pending && !is_accepted_url {
+            return self.render_compact(
+                status_label,
+                status_icon,
+                status_color,
+                header_background,
+                border_color,
+                tool_name_font_size,
+            );
+        }
 
         let body = v_flex()
             .gap_2()
@@ -1529,6 +1539,50 @@ impl<'a> ElicitationCard<'a> {
                 this.child(self.render_actions(cx))
             })
     }
+    fn render_compact(
+        &self,
+        status_label: &'static str,
+        status_icon: IconName,
+        status_color: Color,
+        header_background: Hsla,
+        border_color: Hsla,
+        tool_name_font_size: Rems,
+    ) -> Div {
+        h_flex()
+            .mx_5()
+            .my_1()
+            .px_2p5()
+            .py_1()
+            .h_7()
+            .rounded_md()
+            .border_1()
+            .border_color(border_color)
+            .bg(header_background)
+            .justify_between()
+            .child(
+                h_flex()
+                    .min_w_0()
+                    .gap_1p5()
+                    .child(
+                        Icon::new(status_icon)
+                            .size(IconSize::Small)
+                            .color(status_color),
+                    )
+                    .child(
+                        Label::new(format!(
+                            "Input from {}: {}",
+                            self.requester_name, self.elicitation.request.message
+                        ))
+                        .size(LabelSize::Custom(tool_name_font_size))
+                        .truncate(),
+                    ),
+            )
+            .child(
+                Label::new(status_label)
+                    .size(LabelSize::Small)
+                    .color(status_color),
+            )
+    }
 
     fn render_form(&self, mode: &acp::ElicitationFormMode, cx: &App) -> AnyElement {
         let Some(state) = self.form_state else {
-- 
