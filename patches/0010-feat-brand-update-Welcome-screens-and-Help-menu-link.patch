From 9756707fca8ab50be25394f4b5eaed032bb22325 Mon Sep 17 00:00:00 2001
From: Katalyst Contributors <noreply@katalyst.dev>
Date: Mon, 7 Sep 2026 18:27:41 +0700
Subject: [PATCH 10/19] feat(brand): update Welcome screens and Help menu links
 to Katalyst & LinkedIn

---
 crates/onboarding/src/onboarding.rs |  4 ++--
 crates/workspace/src/welcome.rs     |  4 ++--
 crates/zed/src/zed/app_menus.rs     | 13 ++++++-------
 scripts/safe-rebuild.sh             |  2 +-
 4 files changed, 11 insertions(+), 12 deletions(-)

diff --git a/crates/onboarding/src/onboarding.rs b/crates/onboarding/src/onboarding.rs
index 220c2b0..962737c 100644
--- a/crates/onboarding/src/onboarding.rs
+++ b/crates/onboarding/src/onboarding.rs
@@ -351,11 +351,11 @@ impl Render for Onboarding {
                                             .child(
                                                 v_flex()
                                                     .child(
-                                                        Headline::new("Welcome to Zed")
+                                                        Headline::new("Welcome to Katalyst")
                                                             .size(HeadlineSize::Small),
                                                     )
                                                     .child(
-                                                        Label::new("The editor for what's next")
+                                                        Label::new("The autonomous agentic editor")
                                                             .color(Color::Muted)
                                                             .size(LabelSize::Small)
                                                             .italic(),
diff --git a/crates/workspace/src/welcome.rs b/crates/workspace/src/welcome.rs
index 837418e..1016cc1 100644
--- a/crates/workspace/src/welcome.rs
+++ b/crates/workspace/src/welcome.rs
@@ -448,9 +448,9 @@ impl Render for WelcomePage {
         };
 
         let welcome_label = if self.fallback_to_recent_projects {
-            "Welcome back to Zed"
+            "Welcome back to Katalyst"
         } else {
-            "Welcome to Zed"
+            "Welcome to Katalyst"
         };
 
         h_flex()
diff --git a/crates/zed/src/zed/app_menus.rs b/crates/zed/src/zed/app_menus.rs
index 551b02a..a29cfe8 100644
--- a/crates/zed/src/zed/app_menus.rs
+++ b/crates/zed/src/zed/app_menus.rs
@@ -317,22 +317,21 @@ pub fn app_menus(cx: &mut App) -> Vec<Menu> {
                 MenuItem::action("Email Us...", zed_actions::feedback::EmailZed),
                 MenuItem::separator(),
                 MenuItem::action(
-                    "Documentation",
+                    "Katalyst Documentation",
                     super::OpenBrowser {
-                        url: "https://zed.dev/docs".into(),
+                        url: "https://github.com/Envy-7z/katalyst#readme".into(),
                     },
                 ),
-                MenuItem::action("Zed Repository", feedback::OpenZedRepo),
                 MenuItem::action(
-                    "Zed Twitter",
+                    "Katalyst Repository",
                     super::OpenBrowser {
-                        url: "https://twitter.com/zeddotdev".into(),
+                        url: "https://github.com/Envy-7z/katalyst".into(),
                     },
                 ),
                 MenuItem::action(
-                    "Join the Team",
+                    "Contact Creator (LinkedIn)",
                     super::OpenBrowser {
-                        url: "https://zed.dev/jobs".into(),
+                        url: "https://github.com/Envy-7z/katalyst".into(),
                     },
                 ),
             ],
diff --git a/scripts/safe-rebuild.sh b/scripts/safe-rebuild.sh
index fc18786..0db3883 100755
--- a/scripts/safe-rebuild.sh
+++ b/scripts/safe-rebuild.sh
@@ -10,7 +10,7 @@ APP_BUNDLE="/Applications/Katalyst.app"
 APP_BIN="$APP_BUNDLE/Contents/MacOS/zed"
 JOBS="${ZED_BUILD_JOBS:-2}"
 MIN_FREE_GB="${ZED_MIN_FREE_GB:-12}"
-
+PROFILE="${ZED_BUILD_PROFILE:-release-fast}"
 cd "$REPO_DIR"
 export PATH="/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"
 export CARGO_INCREMENTAL=0
-- 
2.55.0

