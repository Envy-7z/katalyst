From 5bc6a531ac176aaec67a334c2b0a210e46bf705a Mon Sep 17 00:00:00 2001
From: Wisnuu <wisnuandrian325@gmail.com>
Date: Fri, 11 Sep 2026 03:32:12 +0700
Subject: [PATCH 18/19] build(scripts): inject dynamic git commit sha into
 rebuild scripts

---
 scripts/safe-rebuild.sh     | 2 ++
 scripts/sync-and-rebuild.sh | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/scripts/safe-rebuild.sh b/scripts/safe-rebuild.sh
index 63cf4c5..2ded7fd 100755
--- a/scripts/safe-rebuild.sh
+++ b/scripts/safe-rebuild.sh
@@ -15,6 +15,8 @@ cd "$REPO_DIR"
 export PATH="/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"
 export CARGO_INCREMENTAL=0
 export RUSTFLAGS="${RUSTFLAGS:--C debuginfo=0}"
+export ZED_COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null || echo "")"
+export ZED_BUILD_ID="${ZED_BUILD_ID:-custom}"
 
 if [[ "$PROFILE" == "release" ]]; then
   export CARGO_PROFILE_RELEASE_LTO=false
diff --git a/scripts/sync-and-rebuild.sh b/scripts/sync-and-rebuild.sh
index 1c4b0a6..474f837 100755
--- a/scripts/sync-and-rebuild.sh
+++ b/scripts/sync-and-rebuild.sh
@@ -14,6 +14,8 @@ cd "$REPO_DIR"
 export PATH="/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"
 export CARGO_INCREMENTAL=0
 export RUSTFLAGS="${RUSTFLAGS:--C debuginfo=0}"
+export ZED_COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null || echo "")"
+export ZED_BUILD_ID="${ZED_BUILD_ID:-custom}"
 
 if [[ "$PROFILE" == "release" ]]; then
   export CARGO_PROFILE_RELEASE_LTO=false
-- 
