Subject: [PATCH 19/19] fix(build): unlink active binary before cp to prevent
 Operation not permitted

---
 scripts/safe-rebuild.sh | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/safe-rebuild.sh b/scripts/safe-rebuild.sh
index 2ded7fd..a066b42 100755
--- a/scripts/safe-rebuild.sh
+++ b/scripts/safe-rebuild.sh
@@ -53,6 +53,7 @@ fi
 
 if [[ -d "$APP_BUNDLE" ]]; then
   echo "Installing $SRC -> $APP_BIN"
+  rm -f "$APP_BIN" 2>/dev/null || true
   cp "$SRC" "$APP_BIN"
   # Preserve Katalyst branding (name, icon, App Switcher id)
   plutil -replace CFBundleDisplayName -string "Katalyst" "$APP_BUNDLE/Contents/Info.plist" 2>/dev/null || true
