From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Katalyst Contributors <noreply@katalyst.dev>
Date: Sat, 10 Oct 2026 17:42:00 +0700
Subject: [PATCH] fix(build): preserve indirect symbols when stripping macOS binaries

---
 script/bundle-mac | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/script/bundle-mac b/script/bundle-mac
--- a/script/bundle-mac
+++ b/script/bundle-mac
@@ -348,9 +348,9 @@ upload_debug_symbols
 # also keep symbols recoverable when the sentry upload is skipped.
 if [[ "$target_dir" == "release" && "$local_install" != true ]]; then
     extract_debug_symbols
-    strip -x "target/${target_triple}/${target_dir}/zed"
-    strip -x "target/${target_triple}/${target_dir}/cli"
-    strip -x "target/${target_triple}/${target_dir}/remote_server"
+    strip -S "target/${target_triple}/${target_dir}/zed"
+    strip -S "target/${target_triple}/${target_dir}/cli"
+    strip -S "target/${target_triple}/${target_dir}/remote_server"
 fi
 
 cp target/${target_triple}/${target_dir}/zed "${app_path}/Contents/MacOS/zed"
-- 
2.50.1 (Apple Git-155)
